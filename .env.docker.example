# [claude] Variables for `docker compose`, not for the application.
#
# The application reads `.env.{APP_ENV}` from inside the container; compose
# reads this to fill the `${...}` placeholders in docker-compose.yml before
# the container exists. Two different files with two different jobs, which
# is why this one is not called `.env` — a bare `.env` beside
# `.env.development` invites reading one and editing the other.
#
#     cp .env.docker.example docker.env      # then fill it in
#     docker compose --env-file docker.env up -d --build
#
# Without it the stack still starts. It will answer `/health` and fail the
# first question, because MODEL_BASE_URL points nowhere.

# The model endpoint. `host.docker.internal` reaches a server running on
# the host machine rather than in compose.
MODEL_NAME=gemma-4
MODEL_BASE_URL=http://host.docker.internal:8001/v1
MODEL_API_KEY=

# Optional. Without it the research agent reports web search as
# unavailable rather than failing on use.
TAVILY_API_KEY=

LOG_LEVEL=INFO

# The console signs itself in with this, so you do not paste a token.
# Mint one on the host — the container verifies, it never mints:
#     python scripts/dev_token.py mint --expires 2592000
DEV_UI_TOKEN=

# Must match whatever minted DEV_UI_TOKEN. The defaults in
# .env.development.example are what dev_token.py uses.
JWT_ISSUER=https://dev.marq.local
JWT_AUDIENCE=marq-agent
