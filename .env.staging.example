# [claude] Rewritten to match app/config.py Settings field names.
# The previous template used POSTGRES_DSN / LLM_* keys that Settings does not
# define, so it was missing 7 required fields and import raised ValidationError.
#
# Copy to .env.staging and fill in. APP_ENV selects which file is loaded.

APP_ENV=staging
LOG_LEVEL=INFO
API_V1_PREFIX=/v1

# MarQ CRM HTTP API (not yet used)
MARQ_CRM_BASE_URL=
MARQ_CRM_API_KEY=

# Chat model (OpenAI-compatible endpoint, e.g. vLLM)
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# 0.0 = deterministic. Leave at 0 unless you want varied prose.
MODEL_TEMPERATURE=0.0

# Marquise application database (required)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=marq_agent_staging

# Read-only role for CRM reads (see migrations/001_read_only_role.sql).
# Unset falls back to POSTGRES_USER, in which case the SQL guard is the only
# thing preventing a generated query from writing.
POSTGRES_READONLY_USER=marq_agent_ro
POSTGRES_READONLY_PASSWORD=

# CRM database (optional until the CRM connection is wired)
CRM_POSTGRES_HOST=
CRM_POSTGRES_PORT=5432
CRM_POSTGRES_USER=
CRM_POSTGRES_PASSWORD=
CRM_POSTGRES_DB=

# Required
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=marq_agent_staging

# Workspace — user-uploaded files (optional; defaults shown)
# WORKSPACE_ROOT holds uploads and their parsed content. Keep it outside the
# repository tree: these files contain customer data.
WORKSPACE_ROOT=./var/workspace
WORKSPACE_COLLECTION=marq_workspace
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ==========================================================
# HTTP API layer
# ==========================================================
# [claude] LOG_LEVEL and API_V1_PREFIX were already here and were read by
# nothing — Settings did not declare them and extra="ignore" swallowed them.
# They work now. The rest are new.

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins the website front end is served from. Empty means
# no cross-origin access. Not "*": a wildcard with credentials is rejected by
# browsers anyway, so it would be a setting that looks like it works.
CORS_ORIGINS=

# ----------------------------------------------------------
# JWT bearer authentication
# ----------------------------------------------------------
# The front end authenticates its own users and presents a signed token. The
# employee id is read from a claim and becomes `app.requester_id` in
# PostgreSQL, which is what row-level security filters on — so it must come
# from the token issuer, never from the request.
#
# RS256 is preferred: the issuer keeps the private key and this service only
# needs the public half, so a compromise here cannot mint tokens.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
# Only for HS* algorithms; leave empty when using RS256/ES256.
JWT_SECRET=
# Verified when set. Set both in anything real: without an audience check, a
# token minted for another service by the same issuer is accepted here.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SUBJECT_CLAIM=sub

# Must stay false. It accepts an unsigned identity header, which is
# every employee's data to any caller.
AUTH_DEV_MODE=false

# ----------------------------------------------------------
# Uploads and conversation persistence
# ----------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# postgres = conversations survive restarts and span workers.
# memory    = in-process only; /health/ready reports it as not ready.
CHECKPOINTER_BACKEND=postgres

# ----------------------------------------------------------
# Web search (Research Agent)
# ----------------------------------------------------------
# [claude] Optional. Unset means the Research Agent reports that it cannot
# look things up, rather than failing.
#
# A query sent here LEAVES YOUR INFRASTRUCTURE and is logged by a third
# party. Only the Research Agent holds the tool and it has no CRM access, so
# nothing derived from the database can reach Tavily through it.
TAVILY_API_KEY=

# ------------------------------------------------------------------
# Local console
# ------------------------------------------------------------------
# [claude] A token the console at / picks up on its own, so you do not
# have to mint one and paste it in. Development only — the app refuses to
# start if this is set with APP_ENV=production, and the route that serves
# it is not registered there.
#
# Mint one that lasts:
#     python scripts/dev_token.py mint --expires 2592000   # 30 days
#
# Leave it empty to go back to pasting a token by hand.
DEV_UI_TOKEN=
