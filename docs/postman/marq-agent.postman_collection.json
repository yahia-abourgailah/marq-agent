    {
      "name": "Negative tests",
      "description": "The boundaries. All of these SHOULD fail \u2014 that is the point.",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Every route that touches data requires a token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How many deals?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().error.code).to.eql(\"unauthorized\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Garbage token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer not.a.real.token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Signature verification. The message is identical to every other auth failure on purpose \u2014 distinguishing them tells an attacker which half of a guess was right.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How many deals?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "workspace_id in body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Identity is never a request field. Refused rather than ignored: an ignored field returns 200 with an answer computed from your own identity, so the frontend concludes it works and the mistake surfaces much later.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How many deals?\",\n  \"workspace_id\": \"someone-elses-workspace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"names the offending field\", () => pm.expect(pm.response.text()).to.include(\"workspace_id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "requester_id in body -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Same rule. This id becomes `app.requester_id` in PostgreSQL and decides which rows row-level security returns.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How many deals?\",\n  \"requester_id\": \"someone-else\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty message -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Body validation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Someone else's thread -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/threads/definitely-not-yours",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "threads",
                "definitely-not-yours"
              ]
            },
            "description": "404, not 403 \u2014 a 403 would confirm which thread ids exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
