          "name": "Delete a conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/threads/{{thread_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "threads",
                "{{thread_id}}"
              ]
            },
            "description": "Removes the checkpoints first, then the index row. Deletes messages too \u2014 re-run *Ask a question* afterwards."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workspace",
      "description": "Uploaded files. Select a real .xlsx / .csv / .pdf in the upload request's Body tab.",
      "item": [
        {
          "name": "Upload a file",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/workspace/files",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "workspace",
                "files"
              ]
            },
            "description": "**Pick a file in the Body tab before sending** \u2014 Postman cannot store one in an exported collection.\n\nRe-uploading the same filename supersedes the previous copy, vectors and all.\n\nThe file lands in *your* workspace, derived from your token. Nobody else can see it.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": ".xlsx .xlsm .csv .tsv or .pdf, up to 25 MB"
                }
              ]
