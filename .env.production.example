# [claude] Rewritten to match app/config.py Settings field names.
# The previous template used POSTGRES_DSN / LLM_* keys that Settings does not
# define, so it was missing 7 required fields and import raised ValidationError.
#
# Copy to .env.production and fill in. APP_ENV selects which file is loaded.

APP_ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/v1

# MarQ CRM HTTP API (not yet used)
MARQ_CRM_BASE_URL=
MARQ_CRM_API_KEY=

# Chat model (OpenAI-compatible endpoint, e.g. vLLM)
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# 0.0 = deterministic. Leave at 0 unless you want varied prose.
MODEL_TEMPERATURE=0.0

# Marquise application database (required)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=marq_agent_prod

# CRM database (optional until the CRM connection is wired)
CRM_POSTGRES_HOST=
CRM_POSTGRES_PORT=5432
CRM_POSTGRES_USER=
CRM_POSTGRES_PASSWORD=
CRM_POSTGRES_DB=

# Required
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=marq_agent_prod

# Workspace — user-uploaded files (optional; defaults shown)
# WORKSPACE_ROOT holds uploads and their parsed content. Keep it outside the
# repository tree: these files contain customer data.
WORKSPACE_ROOT=./var/workspace
WORKSPACE_COLLECTION=marq_workspace
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
